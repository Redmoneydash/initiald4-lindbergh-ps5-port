+            char *q = s_patched;
+            while (*q && o2 < (int)sizeof(pass2) - 1) {
+                char *e = strchr(q, '\n');
+                int ll = e ? (int)(e - q + 1) : (int)strlen(q);
+                if (strncmp(q, "OUTPUT ", 7) == 0 && na < 8) {
