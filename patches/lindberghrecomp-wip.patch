+         * because the SHORT-skip above already advanced i to 'T'. */
+        if (src[i] == 'T' && (strncmp(src+i,"TEMP RC;",8)==0 ||
+                               strncmp(src+i,"TEMP HC;",8)==0 ||
+                               strncmp(src+i,"TEMP RC,",8)==0 ||
+                               strncmp(src+i,"TEMP HC,",8)==0)) {
