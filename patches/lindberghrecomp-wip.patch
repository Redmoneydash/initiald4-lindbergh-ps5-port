+            static char p4[160000]; int o4 = 0;
+            char *r = s_patched;
+            while (*r && o4 < (int)sizeof(p4) - 1) {
+                char *nl = strchr(r, '\n');
+                int ll = nl ? (int)(nl - r + 1) : (int)strlen(r);
+                int drop = 0;
