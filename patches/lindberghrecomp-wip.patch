+    /* Dump the faulting thread's ucontext — rip/rsp of the real abort site. */
+    {
+        char ln[96];
+        const uint64_t *m = (const uint64_t *)&((ucontext_t *)uc)->uc_mcontext;
+        uint64_t rsp = 0;
+        /* FreeBSD amd64 mcontext64 layout — mc[16]=rip, mc[19]=rsp per
