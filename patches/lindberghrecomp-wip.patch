+                while (k < ll && (r[k] == ' ' || r[k] == '\t')) k++;
+                int os = k;
+                while (k < ll && ((r[k] >= 'A' && r[k] <= 'Z') ||
+                                  (r[k] >= '0' && r[k] <= '9') || r[k] == '_'))
