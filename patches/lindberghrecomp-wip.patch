+            {"ADDR",4,"ADD",3},{"SUBR",4,"SUB",3},{"MULR",4,"MUL",3},
+            {"MINR",4,"MIN",3},{"MAXR",4,"MAX",3},{"RCPR",4,"RCP",3},
+            {"RSQR",4,"RSQ",3},{"MOVR",4,"MOV",3},{"FLRR",4,"FLR",3},
+            {"FRCR",4,"FRC",3},{"DP3R",4,"DP3",3},{"DP4R",4,"DP4",3},
+            {"LRPR",4,"LRP",3},{"EX2R",4,"EX2",3},{"LG2R",4,"LG2",3},
