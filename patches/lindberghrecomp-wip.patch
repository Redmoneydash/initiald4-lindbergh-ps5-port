+        0x3000u /*CLIP_PLANE0*/, 0x3001u /*CLIP_PLANE1*/, 0x3002u /*CLIP_PLANE2*/,
+        0x3003u /*CLIP_PLANE3*/, 0x3004u /*CLIP_PLANE4*/, 0x3005u /*CLIP_PLANE5*/};
