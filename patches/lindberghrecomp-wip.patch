+                            "getObject returned NULL (empty ObjectDatabase after "
+                            "failed .efo deserialize); this .efo will be absent\n");
+        }
+        return;
+    }
+    *(uint32_t *)(uintptr_t)(obj + 4u) += 1u;
+}
