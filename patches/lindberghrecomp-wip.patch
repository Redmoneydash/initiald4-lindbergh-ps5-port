+    if (!s_pop)   s_pop   = (PFPV)gl_resolve("glPopAttrib");
+    if (!s_pushc) s_pushc = (PFPA)gl_resolve("glPushClientAttrib");
+    if (!s_popc)  s_popc  = (PFPV)gl_resolve("glPopClientAttrib");
