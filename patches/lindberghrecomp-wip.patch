+            for (int qi = 0; quals[qi]; qi++) {
+                int qlen = (int)strlen(quals[qi]);
+                char *p = s_patched;
+                while ((p = (char*)fmemfind(p, out - (int)(p - s_patched), quals[qi], qlen))) {
+                    int tail = out - (int)(p - s_patched) - qlen;
+                    memmove(p, p + qlen, tail + 1);
+                    out -= qlen;
+                }
+            }
+        }
